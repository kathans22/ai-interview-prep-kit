# =============================================================================
# AI Interview Prep Kit — environment template
# Copy to .env and fill the blanks. NEVER commit .env.
# The three blank values below are the only secrets.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
# development | production. Controls cookie security and the SSRF host policy
# default. Anything other than "production" is treated as local.
NODE_ENV=development
# Port the Express API listens on.
PORT=4000
# Origin allowed by CORS, with credentials. The Vite dev server locally; the
# deployed frontend URL in production.
WEB_ORIGIN=http://localhost:5173

# --- Datastore -------------------------------------------------------------
# MongoDB connection string, read by both the server and the batch CLI.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_prep_kit
# Signs session cookies. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# --- Gemini ----------------------------------------------------------------
# Key from https://aistudio.google.com/apikey
# Keep its Google Cloud project UNBILLED — enabling billing deletes the free
# tier and every call bills from the first token.
GEMINI_API_KEY=
# Pinned stable model. Do NOT use a -latest alias: it can hot-swap to a preview
# or experimental release with tighter rate limits, which would invalidate the
# extraction eval numbers you tuned prompts against.
# 3.6 Flash is chosen for token efficiency and reduced output verbosity — the
# two properties that protect you from TPM throttling and truncated JSON.
GEMINI_MODEL=gemini-3.6-flash
# Optional second model for cheap mechanical calls (hiring-page confirmation,
# flashcards), leaving daily quota for the scored extraction step. Set equal to
# GEMINI_MODEL to disable the split.
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
# The light model's OWN daily ceiling. Every Gemini rate limit is per model, so the
# split only buys quota if the second model is counted separately — which it now is.
# Leave blank to reuse GEMINI_RPD, which is conservative: a lite model usually allows
# more, so the worst case is under-using it. Read the real number off your rate-limit
# page and put it here to get the full benefit.
GEMINI_RPD_LIGHT=
# --- The three limits below are YOUR CLIENT-SIDE THROTTLE, not Google's
# --- declared ceiling. Read your real numbers from
# --- https://aistudio.google.com/rate-limit and raise these to match.
# --- Under-shooting costs a little queueing. Over-shooting costs 429s.
# Requests per minute the limiter will allow.
GEMINI_RPM=5
# Input tokens per minute the limiter will allow. Estimated before each send.
GEMINI_TPM=100000
# Requests per DAY. Resets midnight Pacific. Limits are per Cloud PROJECT, not
# per key — a second key in the same project adds nothing.
#
# 20 is not a guess. It is the number Google's own 429 reported for this model:
#   quotaId  GenerateRequestsPerDayPerProjectPerModel-FreeTier
#   metric   generativelanguage.googleapis.com/generate_content_free_tier_requests
#   limit    20   model gemini-3.6-flash
# The placeholder here used to say 200, which is ten times too generous and would
# have let the limiter wave through a whole day's quota before lunch.
#
# WHAT 20/DAY MEANS FOR THIS PROJECT, in plain arithmetic:
#   one full extraction eval  = 5 calls   (a quarter of the day)
#   one five-case batch run   = up to 60  — THREE TIMES the daily ceiling
# So a complete real batch run is not possible on this model's free tier in one
# day. Plan for it: run the batch against the fake provider, keep the eval cache
# committed so re-scoring is free, and spend live calls only on the extraction
# eval and the one recorded demo run. Check your own figure at
# https://aistudio.google.com/rate-limit — it moves with account tier and model.
GEMINI_RPD=20
# Hard cap on output tokens per call. Too low silently truncates JSON mid-array,
# which surfaces as finishReason MAX_TOKENS rather than a parse error.
LLM_MAX_OUTPUT_TOKENS=8192

# --- Pipeline budgets ------------------------------------------------------
# Ceiling on Gemini calls per kit, repair retries included. Breaching it skips
# optional enrichment and assembles from what exists rather than running away.
MAX_LLM_CALLS_PER_KIT=12
# Soft per-case deadline. On breach, optional steps are skipped and the kit
# records what was dropped. Only flashcards and the third coverage pass are
# optional — the public discussion search degrades but always runs.
CASE_SOFT_DEADLINE_MS=150000
# How many batch cases run concurrently. Both this and the crawler draw on ONE
# shared limiter, so raising it does not multiply your allowed rate.
BATCH_CONCURRENCY=2
# Window in which an identical job description, company URL and day count
# returns the existing kit instead of generating a second time. 15 minutes.
IDEMPOTENCY_WINDOW_MS=900000

# --- Retrieval -------------------------------------------------------------
# Which public-discussion search implementation to load: tavily | none
# "none" selects the no-op provider: the step still runs and records an honest
# empty result, which scores. Skipping the step entirely does not.
SEARCH_PROVIDER=tavily
# Key from tavily.com — 1,000 credits/month, no card required. Leave blank and
# the provider falls back to the no-op path rather than crashing.
SEARCH_API_KEY=
# Allow fetching private and loopback addresses.
# TRUE locally: the batch fixture sites are served from localhost:8099 and the
# crawl will report every case unreachable without this.
# FALSE in production, or the crawler becomes an SSRF hole.
ALLOW_PRIVATE_HOSTS=true
# Maximum pages fetched per company site during a single crawl.
CRAWL_MAX_PAGES=12
# How many links deep the crawler follows from the company's root page. 2 reaches a
# hiring page linked from a handbook or an about page, which is where the fixture hides
# one; 3 mostly finds blog archives. Optional — core defaults to 2 if unset.
CRAWL_MAX_DEPTH=2
# Concurrent page fetches within one crawl, with a per-host delay applied.
# NOTE: this is the crawler's OWN semaphore, not the Gemini limiter. Page fetches are
# HTTP to someone else's server; admitting them through a 20-a-day model quota would
# spend the whole quota on HTML before a single question was generated (CF-029).
CRAWL_CONCURRENCY=3
# Per-request timeout for an external page fetch, in milliseconds.
FETCH_TIMEOUT_MS=10000
# Maximum response size accepted from an external page, in bytes. Part of the
# "restrict handling to expected content types and sizes" requirement.
FETCH_MAX_BYTES=2000000

# --- Fixtures (local development only) -------------------------------------
# Port for the static server hosting the acme / nohire / broken / hostile test
# sites. Referenced by fixtures/cases.sample.json.
FIXTURE_PORT=8099

# =============================================================================
# PRODUCTION OVERRIDES — set these at deploy time (Stage 17)
#
#   NODE_ENV=production
#   WEB_ORIGIN=https://<your-deployed-frontend>
#   MONGODB_URI=<Atlas connection string>
#   ALLOW_PRIVATE_HOSTS=false      <-- the one that matters most
#
# FIXTURE_PORT is unused in production.
# =============================================================================