# Copy to .env and fill in the blanks. Never commit .env.
#
#   cp .env.example .env
#
# Every variable below is read at boot by apps/server/src/config/env.js, which exits
# with a list of what is missing rather than letting an empty value surface three
# stages later as a confusing 404.

# --- Datastore -------------------------------------------------------------
# MongoDB connection string the server and the batch CLI both read.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_prep_kit
# Secret used to sign session cookies. Generate it, do not type it:
#   openssl rand -hex 32
SESSION_SECRET=

# --- Gemini ----------------------------------------------------------------
# Key from https://aistudio.google.com/apikey — keep its Cloud project UNBILLED.
# Enabling billing deletes the free tier and every call bills from the first token.
GEMINI_API_KEY=
#
# Pin a SPECIFIC STABLE model id. Three things to avoid:
#   -latest aliases  — they hot-swap to whatever released most recently, which can be
#                      a preview or experimental build. Your Stage 6 eval would then
#                      describe a model you are no longer calling, and the README
#                      cannot answer "which model did you use?" with "whichever".
#   -preview / -exp  — tighter rate limits, and preview models often require billing.
#   2.x and 1.5 ids  — shut down; they return 404. Most tutorials online still use them.
#
# Chosen for this project: token-efficient and less verbose than its predecessor, which
# matters twice over here — TPM is a binding free-tier limit, and verbosity is what
# produces finishReason: MAX_TOKENS, the truncated-JSON failure the pipeline must detect.
# BEFORE you rely on it: open https://aistudio.google.com/rate-limit and compare RPD
# across the Flash models. RPD is the binding constraint, not capability. If a different
# stable Flash is meaningfully more generous, take that one — but pin a specific version.
GEMINI_MODEL=gemini-3.6-flash
#
# OPTIONAL two-model split, only if RPD turns out tight. Routes the near-mechanical
# calls (hiring-page confirmation, flashcards) to a cheaper Flash-Lite while requirement
# extraction — the step that carries the most marks — keeps the better model.
# Leave unset to run everything on GEMINI_MODEL. Optimisation, not correctness.
# GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite
#
# --- The three numbers below are OUR CLIENT-SIDE THROTTLE, not Google's declared
# limits. Google removed the static per-model table; your real ceiling lives at
# https://aistudio.google.com/rate-limit and moves with your account tier. The limiter's
# only job is to stay under whatever that page says. Under-shooting costs a little
# queueing; over-shooting costs 429s and retries this pipeline has no time budget for.
# Start conservative, raise them once you have read your own page.
#
# Requests per minute. At 12 calls per kit and 5 cases per run, 5 RPM with case
# concurrency 2 still clears the fifteen-minute window.
GEMINI_RPM=5
# Tokens per minute.
GEMINI_TPM=100000
# Requests per DAY. Resets at midnight Pacific. Enforced per Cloud PROJECT, not per key —
# a second API key in the same project adds exactly zero quota. This is the limit that
# actually constrains iteration: 5 cases x 12 calls = 60 requests per full batch run.
GEMINI_RPD=200
# Hard cap on output tokens per call. Set too low, the model stops mid-array and the JSON
# either fails to parse or, worse, parses cleanly with items silently missing.
LLM_MAX_OUTPUT_TOKENS=8192

# --- Budgets ---------------------------------------------------------------
# Hard ceiling on Gemini calls per kit, JSON-repair retries included. On breach: log it,
# skip optional enrichment, assemble the kit from what exists. Never abort.
MAX_LLM_CALLS_PER_KIT=12
# Soft per-case deadline in ms. On breach, optional steps are skipped and the kit records
# what was dropped, so degradation stays visible. Skippable: flashcard enrichment, the
# third coverage pass. Never skippable: the public discussion search — it degrades to one
# short query with an honest empty result, because attempted-and-empty scores and
# never-attempted does not.
CASE_SOFT_DEADLINE_MS=150000

# --- Retrieval -------------------------------------------------------------
# Which search implementation to load: tavily | none
# "none" selects the no-op provider — the search still runs and records an honest empty
# result. That is not the same as skipping the step, and only one of the two scores.
SEARCH_PROVIDER=tavily
# Tavily key from https://tavily.com — 1,000 credits/month, no card required. Roughly one
# query per case, so ~250 queries covers 50 full dev runs.
# Dead ends, do not lose time on them: Google Custom Search JSON API is closed to new
# customers and discontinues 2027-01-01 (and needs two values, not one); Brave removed
# its free tier and now requires a card. Backups if Tavily disappoints: Serper.dev
# (2,500 one-time trial queries) or SerpApi (250/month).
SEARCH_API_KEY=
# Allow fetching private, loopback and link-local addresses.
# TRUE for local development — the fixture sites live on http://localhost:8099 and the
# crawler cannot reach them otherwise, which presents as a phantom COMPANY_UNREACHABLE.
# FALSE at deploy time, or the crawler is an SSRF hole pointed at your own network.
ALLOW_PRIVATE_HOSTS=true

# --- Server ----------------------------------------------------------------
# Port the Express API listens on.
PORT=4000
# Origin allowed by CORS — the Vite dev server during development.
WEB_ORIGIN=http://localhost:5173
