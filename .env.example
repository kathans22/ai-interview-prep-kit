# Copy to .env and fill in. Never commit .env.

# --- Datastore -------------------------------------------------------------
# MongoDB connection string the server and CLI both read.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_prep_kit
# Secret used to sign session cookies. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Gemini ----------------------------------------------------------------
# API key from Google AI Studio. Keep its Google Cloud project UNBILLED: enabling
# billing deletes the free tier and every call bills from the first token.
GEMINI_API_KEY=
# Free-tier model id. Read the current one off Google AI Studio — free tier covers
# the Flash and Flash-Lite families only, never Pro.
GEMINI_MODEL=
# Requests per minute allowed for that model. Verify on the official rate limits page.
GEMINI_RPM=
# Tokens per minute allowed for that model. Verify on the official rate limits page.
GEMINI_TPM=
# Requests per DAY allowed for that model. This is the binding limit while iterating.
GEMINI_RPD=
# Hard cap on output tokens per call. Too low silently truncates JSON mid-array.
LLM_MAX_OUTPUT_TOKENS=8192

# --- Budgets ---------------------------------------------------------------
# Hard ceiling on Gemini calls per kit, repairs included. Breaching it skips optional
# enrichment and assembles from what exists.
MAX_LLM_CALLS_PER_KIT=12
# Soft per-case deadline. On breach, optional steps are skipped and the kit records
# what was dropped. The public discussion search is never dropped, only degraded.
CASE_SOFT_DEADLINE_MS=150000

# --- Retrieval -------------------------------------------------------------
# Key for the public discussion search provider. Empty means the search degrades to
# an honest empty result rather than being skipped.
SEARCH_API_KEY=
# Allow fetching private/loopback addresses. Must be true for the local fixture sites
# on localhost:8099, and false anywhere real, or the crawler becomes an SSRF hole.
ALLOW_PRIVATE_HOSTS=false

# --- Server ----------------------------------------------------------------
# Port the Express API listens on.
PORT=4000
# Origin allowed by CORS — the Vite dev server during development.
WEB_ORIGIN=http://localhost:5173
